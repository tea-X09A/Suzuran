## 敵の死亡ステート
## 死亡演出中は何も処理を行わず、方向転換などの挙動を防止
class_name EnemyDeadState
extends EnemyBaseState

# ======================== 状態初期化 ========================

## 死亡ステート開始時の処理
func initialize_state() -> void:
	# 速度を0にリセット（直前の速度を引き継がないようにする）
	enemy.velocity = Vector2.ZERO
	# アニメーションは設定しない（死亡演出はenemy.gdで管理）

# ======================== 状態クリーンアップ ========================

## 死亡ステート終了時の処理
func cleanup_state() -> void:
	# 何もしない
	pass

# ======================== 物理更新処理 ========================

## 物理演算ステップでの更新処理
## 死亡状態では何も処理せず、移動や方向転換などを一切行わない
func physics_update(_delta: float) -> void:
	# 何も処理しない（重力も適用しない、移動もしない）
	pass
